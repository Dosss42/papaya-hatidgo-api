    {
      "name": "PayMongo webhook (simulated, signed)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const eventId = 'evt_postman_' + pm.collectionVariables.get('subscription_id');",
              "const payment = { id: \"pay_\" + eventId, type: \"payment\", attributes: { status: \"paid\", amount: Number(pm.collectionVariables.get(\"amount_centavos\")), source: { type: \"gcash\" } } };",
              "const checkout = { id: pm.collectionVariables.get(\"checkout_id\"), type: \"checkout_session\", attributes: { payment_method_used: \"gcash\", payments: [payment] } };",
              "const body = JSON.stringify({ data: { id: eventId, type: \"event\", attributes: { type: \"checkout_session.payment.paid\", livemode: false, data: checkout } } });",
              "const t = Math.floor(Date.now() / 1000);",
              "const sig = CryptoJS.HmacSHA256(t + '.' + body, pm.collectionVariables.get('webhook_secret')).toString(CryptoJS.enc.Hex);",
              "pm.variables.set('webhook_body', body);",
              "pm.request.headers.upsert({ key: 'Paymongo-Signature', value: 't=' + t + ',te=' + sig });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "{{lang}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{webhook_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/webhooks/paymongo",
        "description": "Plays PayMongo: a checkout_session.payment.paid event for {{checkout_id}}, signed like PayMongo (HMAC-SHA256 of \"t.body\" with webhook_secret). Set PAYMONGO_WEBHOOK_SECRET in .env to the same value. Send it twice: the second answer is \"duplicate\" (idempotency). Change amount_centavos to see the amount check refuse it."
      }
    }
  ]
}
