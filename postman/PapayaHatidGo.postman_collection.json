                  "  pm.collectionVariables.set('checkout_url', body.data.checkout_url);",
                  "  const m = body.data.checkout_url.match(/(fake_)?cs_[A-Za-z0-9]+/);",
                  "  if (m) { pm.collectionVariables.set('checkout_id', m[0]); }",
